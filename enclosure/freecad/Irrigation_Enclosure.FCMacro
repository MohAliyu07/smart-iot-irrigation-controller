, 26.5, -24.4, 10.16], ["J16", 20.46, -23.74, 30.87, -12.69, 10.16], ["LED1", -18.78, 15.53, -14.31, 17.82, 0.76], ["LED2", -16.62, 29.43, -12.15, 31.71, 0.76], ["LED3", -3.42, -18.15, 1.05, -15.86, 0.76], ["LED4", 3.44, -19.57, 7.91, -17.28, 0.76], ["LED5", 8.42, -19.52, 12.89, -17.23, 0.76], ["LED6", 3.8, -7.61, 8.27, -5.32, 0.76], ["LED7", 11.19, -10.12, 15.66, -7.84, 0.76], ["Q1", -30.85, -14.52, -25.67, -7.25, 1.65], ["Q2", -11.8, -19.9, -8.6, -16.68, 1.14], ["Q3", 10.55, -15.99, 13.78, -12.76, 1.14], ["Q4", -1.36, -15.07, 1.87, -11.87, 1.14], ["Q5", 15.76, -6.87, 18.96, -3.64, 1.14], ["Q6", 4.28, -4.53, 7.51, -1.33, 1.14], ["Q7", 14.57, 5.22, 18.3, 8.47, 1.14], ["Q8", -19.39, -27.06, -16.17, -23.86, 1.14], ["R1", -40.3, -9.18, -36.89, -7.71, 0.51], ["R2", -13.37, 14.9, -9.97, 16.37, 0.51], ["R3", -10.25, 5.93, -6.85, 7.4, 0.51], ["R4", -18.17, 18.68, -14.77, 20.15, 0.51], ["R5", -15.35, 35.06, -11.98, 36.54, 0.51], ["R6", -25.72, 29.6, -22.31, 31.08, 0.51], ["R7", -26.12, 26.94, -22.75, 28.41, 0.51], ["R8", -25.87, 22.77, -22.47, 24.27, 0.51], ["R9", -15.53, 38.27, -12.13, 39.74, 0.51], ["R10", -14.49, -25.97, -11.09, -24.5, 0.51], ["R11", -12.23, -22.44, -8.83, -20.97, 0.51], ["R12", -15.1, 32.5, -11.7, 33.97, 0.51], ["R13", -21.68, 23.36, -18.28, 24.85, 0.51], ["R14", 23.69, 15.56, 27.09, 17.03, 0.51], ["R15", 10.05, 6.13, 13.45, 7.61, 0.51], ["R16", 10.27, 9.03, 13.68, 10.5, 0.51], ["R17", 18.45, 17.08, 21.86, 18.55, 0.51], ["R18", 13.22, 16.19, 16.62, 17.67, 0.51], ["R19", 9.31, 11.6, 12.71, 13.07, 0.51], ["R20", 13.98, 13.5, 17.39, 14.97, 0.51], ["R21", -2.48, -5.52, 0.93, -4.05, 0.51], ["R22", -2.02, -9.11, 1.38, -7.61, 0.51], ["R23", -6.69, -21.76, -3.29, -20.28, 0.51], ["R24", 3.59, -22.03, 7.0, -20.54, 0.51], ["R25", -1.23, -21.02, 2.17, -19.55, 0.51], ["R26", 9.03, -22.31, 12.43, -20.84, 0.51], ["R27", 4.23, -24.55, 7.63, -23.08, 0.51], ["R28", 13.78, -18.45, 17.18, -16.98, 0.51], ["R29", -0.39, -24.52, 2.98, -23.05, 0.51], ["R30", 9.06, 1.08, 12.46, 2.55, 0.51], ["R31", 16.4, -9.31, 19.8, -7.84, 0.51], ["R32", 4.76, 0.04, 8.17, 1.51, 0.51], ["R33", 14.77, -12.92, 18.17, -11.44, 0.51], ["R34", 19.65, -5.07, 23.05, -3.59, 0.51], ["R35", 8.24, 3.62, 11.65, 5.12, 0.51], ["RS1", -9.77, -14.77, -2.25, -11.21, 0.64], ["SW1", 18.91, 23.0, 26.02, 28.33, 1.52], ["SW2", 10.55, 23.08, 17.67, 28.44, 1.52], ["U1", -9.74, 17.23, 9.69, 43.57, 3.1], ["U2", -27.06, 5.52, -15.3, 14.8, 10.41], ["U3", -14.59, 6.31, -11.04, 10.12, 1.14], ["U4", -16.98, 25.11, -13.37, 28.74, 1.14], ["U5", -7.56, -19.47, -3.98, -15.86, 1.14]]
CUTS=[[-143.81557558142453, -128.57733634922175, 9.0, 17.1], [-120.70214164713907, -105.46390241493633, 9.0, 17.1], [-101.23908938712658, -86.00085015492384, 9.0, 17.1], [-83.16904085261346, -67.93080162041072, 9.0, 17.1], [-62.30995218637719, -47.071712954174444, 9.0, 17.1], [-42.99556780030828, -27.757328568105535, 9.0, 17.1], [172.45843202039333, 185.25855297544365, 8.9, 19.1], [143.42235739659793, 155.61294878236015, 8.4, 12.399999999999999], [-13.318654739273297, 23.25311941801329, 11.6, 16.6]]
# FreeCAD macro: Smart IoT Irrigation Controller v2 - water-drop enclosure (mm)
import FreeCAD as App, Part, math
V = App.Vector
R_BOARD, APEX_K, TIP_R = 45.0, 0.8723, 2.0
GAP, WALL, FLOOR, H = 1.0, 2.0, 2.0, 23.0
BOARD_Z, BT, LID_T, RIM_H = 7.0, 1.6, 2.0, 3.0
SWITCHES = [(22.20, 25.69), (13.84, 25.78)]
LEDS = [(-16.42, 16.69), (-14.26, 30.57)]

def drop_face(off, z=0):
    R = R_BOARD + off; a = math.acos(APEX_K); A = R / APEX_K
    r = max(0.3, TIP_R + off)
    # fillet at apex: centre on y-axis, tangent to both lines
    half = math.pi / 2 - a                     # half apex angle
    dc = r / math.sin(half)                    # apex -> fillet centre
    fc = V(0, A - dc, z)
    t = r / math.tan(half)                     # apex -> tangent point along line
    tl, tr = V(-R * math.sin(a), R * math.cos(a), z), V(R * math.sin(a), R * math.cos(a), z)
    ap = V(0, A, z)
    ul = (tl - ap); ul.normalize(); ur = (tr - ap); ur.normalize()
    fl, fr = ap + ul * t, ap + ur * t
    top = V(0, A - dc + r, z)
    e = [Part.LineSegment(fl, tl).toShape(),
         Part.Arc(tl, V(0, -R, z), tr).toShape(),
         Part.LineSegment(tr, fr).toShape(),
         Part.Arc(fr, top, fl).toShape()]
    return Part.Face(Part.Wire(e))

def prism(off, z0, h): return drop_face(off, z0).extrude(V(0, 0, h))
def box(cx, cy, cz, lx, ly, lz, ang=0.0):
    b = Part.makeBox(lx, ly, lz, V(-lx / 2, -ly / 2, -lz / 2))
    b.rotate(V(0, 0, 0), V(0, 0, 1), math.degrees(ang)); b.translate(V(cx, cy, cz)); return b

doc = App.newDocument('Irrigation_Controller_v2')
# BASE: outer prism minus inner pocket, + ledge, - wall cut-outs
base = prism(GAP + WALL, 0, H).cut(prism(GAP, FLOOR, H))
base = base.fuse(prism(GAP, FLOOR, BOARD_Z - FLOOR).cut(prism(-0.6, FLOOR - 0.1, BOARD_Z)))
for a0, a1, z0, z1 in CUTS:
    am = math.radians((a0 + a1) / 2); w = math.radians(a1 - a0) * 47.0
    base = base.cut(box(47 * math.cos(am), 47 * math.sin(am), (z0 + z1) / 2, 10, w, z1 - z0, am))
base = base.removeSplitter()
# LID (assembled position)
lid = prism(GAP + WALL, H, LID_T).fuse(prism(GAP - 0.25, H - RIM_H, RIM_H).cut(prism(GAP - 1.65, H - RIM_H - 1, RIM_H + 2)))
for x, y in SWITCHES: lid = lid.cut(box(x, y, H + 1, 7.8, 7.8, 10))
for x, y in LEDS: lid = lid.cut(Part.makeCylinder(1.6, 10, V(x, y, H - 5)))
lid = lid.removeSplitter()
# PLUNGERS
sw_top = BOARD_Z + BT + 1.7
pl = []
for x, y in SWITCHES:
    pl.append(box(x, y, sw_top + 0.6, 10, 10, 1.2).fuse(box(x, y, (sw_top + 1.2 + H + LID_T + 1.5) / 2, 6.8, 6.8, H + LID_T + 1.5 - sw_top - 1.2)))
# PCB + component envelopes
pcb = prism(0, BOARD_Z, BT)
parts = [box((x1 + x2) / 2, (y1 + y2) / 2, BOARD_Z + BT + h / 2, max(0.2, x2 - x1 - 0.2), max(0.2, y2 - y1 - 0.2), h) for d, x1, y1, x2, y2, h in COMPS]

def add(name, shape, col, tr=0):
    o = doc.addObject('Part::Feature', name); o.Shape = shape
    if App.GuiUp:
        o.ViewObject.ShapeColor = col; o.ViewObject.Transparency = tr
    return o
add('Enclosure_Base', base, (0.92, 0.93, 0.91))
add('Enclosure_Lid', lid, (0.45, 0.68, 0.53))
for i, p in enumerate(pl): add('Button_Plunger_%d' % (i + 1), p, (0.18, 0.37, 0.26))
add('PCB', pcb, (0.10, 0.42, 0.22))
grp = doc.addObject('App::DocumentObjectGroup', 'Components')
for (d, *_), s in zip(COMPS, parts):
    c = 'J' in d[:1] and d in ('J2','J12','J13','J14','J15','J16')
    col = (0.15, 0.48, 0.18) if c else ((0.78, 0.78, 0.78) if d in ('U1','J3') else ((0.95, 0.93, 0.88) if d.startswith('J') else ((0.9, 0.82, 0.25) if d.startswith('LED') else (0.12, 0.12, 0.12))))
    grp.addObject(add(d, s, col))
doc.recompute()
import os
out = os.path.join(os.path.dirname(os.path.abspath(__file__)) if '__file__' in dir() else App.getUserAppDataDir(), 'Irrigation_Controller_v2.FCStd')
try:
    doc.saveAs(out)
except Exception as ex:
    App.Console.PrintWarning('save failed: %s\n' % ex)
if App.GuiUp:
    import FreeCADGui as Gui
    Gui.ActiveDocument.ActiveView.viewIsometric(); Gui.SendMsgToActiveView('ViewFit')
App.Console.PrintMessage('Irrigation Controller v2 enclosure built.\n')
